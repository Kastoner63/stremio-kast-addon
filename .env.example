# Configuration exemple pour auto-hébergement
# Copie ce fichier en .env puis adapte les valeurs.
#
# Windows PowerShell :
# copy .env.example .env
#
# Linux / macOS :
# cp .env.example .env

NODE_ENV=production
PUBLIC_MODE=true
HOST=0.0.0.0
PORT=7000

# Obligatoire : sert à chiffrer les URLs personnelles /u/cfg_xxxxx/manifest.json
# Générer avec :
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONFIG_ENCRYPTION_SECRET=

# Config distante commune contenant pasteMasterIndexUrl
REMOTE_CONFIG_URL=https://paste.lesalkodiques.com/raw/74ngq2T4
REMOTE_CONFIG_TTL_SECONDS=1800

# Fallback optionnel si la config distante ne répond pas
PASTE_MASTER_INDEX_URL=

# Cache général
CACHE_TTL_SECONDS=21600

# TMDB par défaut
# Les utilisateurs peuvent aussi configurer leur clé TMDB via /configure
TMDB_LANGUAGE=fr-FR
TMDB_POSTER_SIZE=w500
TMDB_BACKDROP_SIZE=w1280

# Sécurité / debug
DEBUG_HEALTH=false
LOG_SENSITIVE_URLS=false

ALLOWED_REMOTE_HOSTS=paste.lesalkodiques.com,web.app,firebaseapp.com
MAX_REMOTE_BYTES=26214400

RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=180
EXPOSE_UNRESOLVED_STREAMS=false

# Optionnel : token admin pour protéger certaines routes de diagnostic/admin
ADMIN_TOKEN=

# Ne pas mettre de clé AllDebrid globale pour une instance publique.
# Chaque utilisateur doit entrer sa propre clé depuis /configure.
ALLDEBRID_API_KEY=
ALLDEBRID_API_TOKEN=
ALLDEBRID_AGENT=KastStremioAddon
